                }
              ],
              "alignItems": "center"
            }
          ],
          "layout": "vertical",
          "fill": "$color-surface",
          "cornerRadius": "$radius-lg",
          "stroke": "$color-divider",
          "strokeWidth": 1,
          "strokeAlignment": "inner",
          "context": "Successful zero-eligible-entry preview is separate from request failure. Draft creation stays available, preserving the existing empty-invoice contract. Excluding every selected entry recalculates hours and amount to zero. Never present a failed eligibility fetch as zero entries.",
          "x": 1820,
          "y": 5390
        }
      ]
