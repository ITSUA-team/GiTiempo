            {
              "type": "frame",
              "id": "EKAO3",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 20,
              "padding": [
                64,
                300
              ],
              "children": [
                {
                  "type": "text",
                  "id": "n4vzF",
                  "fill": "$color-brand",
