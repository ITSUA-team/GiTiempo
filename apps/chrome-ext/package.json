{
  "name": "chrome-ext",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && pnpm run build:chrome && pnpm run build:firefox",
    "build:chrome": "EXT_TARGET=chrome vite build",
    "build:firefox": "EXT_TARGET=firefox vite build",
    "lint": "eslint src vite.config.ts vitest.config.ts --ext .ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "dependencies": {
    "@gitiempo/shared": "workspace:*",
    "@gitiempo/web-config": "workspace:*",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.9",
    "jsdom": "^27.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-web-extension": "^4.5.1",
    "vitest": "^4.1.12"
  }
}
