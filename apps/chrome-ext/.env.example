VITE_EXTENSION_API_BASE_URL=http://localhost:3000
VITE_EXTENSION_FIREBASE_API_KEY=
VITE_EXTENSION_FIREBASE_AUTH_DOMAIN=
VITE_EXTENSION_FIREBASE_PROJECT_ID=
VITE_EXTENSION_USER_SPA_URL=http://localhost:5173/login
VITE_EXTENSION_GOOGLE_CLIENT_ID=
VITE_EXTENSION_GITHUB_SIGNIN_ENABLED=true

# Chrome derives the extension id from this key. Without it it hashes the
# unpacked folder's absolute path instead, so every developer gets a different
# id. Committed on purpose: a public RSA key in base64 DER, not a secret, and it
# only helps if every build uses the same one. Changing it changes the id and
# invalidates the Google OAuth client, the API extension redirect URL, and the
# chrome-extension:// origin in ALLOWED_ORIGINS. To regenerate:
#   openssl genrsa -out key.pem 2048
#   openssl rsa -in key.pem -pubout -outform DER | base64 -w0
VITE_EXTENSION_KEY=ThisKeyIsGoingToBeVeryLongPublicRSAKeyButNotPrivateBecauseEveryUserWillSeeItTroughtManifest