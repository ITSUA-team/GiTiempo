---
import LegalFooter from '../components/LegalFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublicConfig } from '../lib/public-config.mjs';

const config = getPublicConfig(import.meta.env);
const title = 'Privacy Policy — GITiempo';
const description = 'How GITiempo handles personal data in the service and Chrome extension.';
const lastUpdated = '18 August 2026';
---

<BaseLayout {title} {description}>
  <header class="border-b border-white/20 bg-landing-dark text-text-inverse">
    <div class="page-shell flex min-h-18 items-center justify-between gap-4 py-4">
      <a class="text-lg font-bold tracking-[-0.03em]" href="/">GITiempo</a>
      <a class="text-sm font-bold text-landing-purple-light underline underline-offset-4" href="/">Back to home</a>
    </div>
  </header>

  <main id="main-content" class="bg-surface-primary py-12 sm:py-16 lg:py-20">
    <article class="page-shell max-w-[960px]">
      <header class="border-b border-divider pb-8 sm:pb-10">
        <p class="eyebrow text-brand">LEGAL</p>
        <h1 class="mt-5 text-[36px] font-bold leading-[1.05] tracking-[-0.045em] text-text-dark sm:text-5xl">Privacy Policy</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-text-muted sm:text-lg">
          This policy explains how {config.privacyControllerName} handles personal data when you use GITiempo, including its Chrome extension.
        </p>
        <p class="mt-4 text-sm text-text-muted">Last updated: {lastUpdated}</p>
      </header>

      <div class="space-y-10 py-10 text-base leading-7 text-text-muted sm:py-12">
        <section aria-labelledby="privacy-controller">
          <h2 id="privacy-controller" class="card-heading text-text-dark">1. Controller and contact</h2>
          <p class="mt-3">
            {config.privacyControllerName} is responsible for the processing described in this policy. For privacy questions or requests, email
            <a class="font-semibold text-brand underline underline-offset-2 ml-1" href={`mailto:${config.privacyContactEmail}`}>{config.privacyContactEmail}</a>.
          </p>
        </section>

        <section aria-labelledby="privacy-data">
          <h2 id="privacy-data" class="card-heading text-text-dark">2. Information we process</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>Account and authentication information, including your email address and authentication identifier.</li>
            <li>Workspace, project, task, and time-entry information needed to provide the GITiempo service.</li>
            <li>Chrome extension session tokens, stored locally in your browser’s <code>chrome.storage.local</code> until you sign out or clear extension data.</li>
            <li>When you start a timer from a supported GitHub issue page, the repository name and issue number sent to GITiempo to create or start the linked time entry.</li>
          </ul>
          <p class="mt-3">
            The extension may read the issue title and page address locally to recognise a supported GitHub surface and show its control. It does not send the issue title or full page address in the timer-start request.
          </p>
        </section>

        <section aria-labelledby="privacy-purpose">
          <h2 id="privacy-purpose" class="card-heading text-text-dark">3. How we use information</h2>
          <p class="mt-3">
            We process this information to authenticate you, maintain your session, provide time tracking and workspace features, link a timer to GitHub issue context when you choose to start one, protect the service, and meet legal obligations. We do not sell personal data or use GitHub page content for advertising.
          </p>
        </section>

        <section aria-labelledby="privacy-sharing">
          <h2 id="privacy-sharing" class="card-heading text-text-dark">4. Sharing and Google services</h2>
          <p class="mt-3">
            We share information only with service providers that help us operate GITiempo, with your workspace where the information is needed for its time-tracking records, or when required by law. Google authentication is provided through Firebase Authentication, and the extension operates on GitHub pages only when you use it there.
          </p>
          <p class="mt-3">
            The use of information received from Google APIs will adhere to the Chrome Web Store User Data Policy, including the Limited Use requirements.
          </p>
        </section>

        <section aria-labelledby="privacy-retention">
          <h2 id="privacy-retention" class="card-heading text-text-dark">5. Retention and security</h2>
          <p class="mt-3">
            We retain personal data only for as long as needed to provide the service, comply with legal obligations, resolve disputes, and enforce agreements. Access is limited to people and providers who need it to operate the service. No method of transmission or storage is completely secure, so please protect your account credentials and keep your browser up to date.
          </p>
        </section>

        <section aria-labelledby="privacy-rights">
          <h2 id="privacy-rights" class="card-heading text-text-dark">6. Your choices and rights</h2>
          <p class="mt-3">
            You can sign out of the Chrome extension to remove its locally stored session and can remove the extension at any time. Depending on where you live, you may have rights to access, correct, delete, restrict, or object to processing of your personal data, or to request a portable copy. Contact us to exercise these rights; you may also have the right to complain to your local data-protection authority.
          </p>
        </section>

        <section aria-labelledby="privacy-changes">
          <h2 id="privacy-changes" class="card-heading text-text-dark">7. Changes to this policy</h2>
          <p class="mt-3">
            We may update this policy when our service or legal obligations change. We will publish the updated version on this page and revise the date above.
          </p>
        </section>
      </div>
    </article>
  </main>

  <LegalFooter />
</BaseLayout>
