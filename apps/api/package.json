{
  "name": "@gitiempo/api",
  "version": "0.0.1",
  "description": "GI Tiempo backend API",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "e2e:assert-database": "NODE_ENV=test tsx --env-file-if-exists=.env src/db/e2e-database.ts",
    "e2e:prepare": "pnpm run e2e:assert-database && NODE_ENV=test pnpm run db:migrate && NODE_ENV=test pnpm run db:seed",
    "test:e2e": "pnpm run e2e:assert-database && NODE_ENV=test node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config ./vitest.e2e.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/src/db/migrate.js",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "github:identity-preflight": "tsx --env-file-if-exists=.env src/github/scripts/github-identity-preflight.ts",
    "github:repository-reference-preflight": "tsx --env-file-if-exists=.env src/projects/scripts/github-repository-reference-preflight.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:seed:runtime": "node dist/src/db/seed.js",
    "openapi:export": "pnpm run build && node --env-file=.env dist/src/openapi/export.js"
  },
  "dependencies": {
    "@gitiempo/shared": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",

    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.2.1",
    "pdfmake": "0.2.20",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^16.5.0",
    "prettier": "3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  }
}
