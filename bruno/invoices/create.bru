meta {
  name: Create saved invoice document
  type: http
  seq: 2
}
post {
  url: {{baseUrl}}/invoices
  body: json
  auth: bearer
}
auth:bearer {
  token: {{accessToken}}
}
body:json {
  {
    "title": "November development",
    "dateFrom": "2026-11-01",
    "dateTo": "2026-11-30",
    "hourlyRate": 100,
    "currency": "USD",
    "timeEntryIds": [],
    "sender": {"name": "Sender", "address": "Kyiv", "email": "billing@example.com", "taxId": ""},
    "recipient": {"name": "Customer", "address": "London", "email": "accounts@example.com", "taxId": ""},
    "services": "Development services",
    "payment": {"method": "Bank transfer", "terms": "14 days", "beneficiary": "Sender", "provider": "Bank", "account": "DEMO", "instructions": "Include invoice reference"}
  }
}
script:post-response {
  bru.setVar("invoiceId", res.body.id);
  bru.setVar("invoiceRevision", res.body.revision);
}
