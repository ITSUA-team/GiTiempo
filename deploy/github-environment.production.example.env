# GitHub Environment: production
# Safe placeholders only. Configure real values in GitHub Environment variables
# and secrets; do not copy this file into a committed real environment file.

# Frontend deployment variables
CLOUDFLARE_ACCOUNT_ID=
VITE_API_BASE_URL=https://api.gitiempo.com
VITE_ADMIN_APP_URL=https://gitiempo-admin.gitiempo.com
VITE_USER_APP_URL=https://app.gitiempo.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional; "true" or "false" only. Unset means off. Enable it only where the
# API has GITHUB_SIGNIN_CLIENT_ID/GITHUB_SIGNIN_CLIENT_SECRET set, so the
# GitHub sign-in button never opens a flow that cannot complete.
VITE_GITHUB_SIGNIN_ENABLED=false
# Optional; unset hides the login extension link.
VITE_EXTENSION_INSTALL_URL=
PUBLIC_SITE_URL=https://gitiempo.com
PUBLIC_USER_APP_URL=https://app.gitiempo.com/login
PUBLIC_ADMIN_APP_URL=https://gitiempo-admin.gitiempo.com
# Optional GA4 Measurement ID; leave empty to disable landing analytics.
PUBLIC_GA_MEASUREMENT_ID=

# API deployment variables
PUBLIC_API_URL=https://api.gitiempo.com
API_DEPLOY_PATH=/home/admin/gitiempo-production
ALLOWED_ORIGINS=https://app.gitiempo.com,https://gitiempo-admin.gitiempo.com,chrome-extension://<extension-id>
VPS_HOST=vpn.itsua.com
VPS_USER=admin

# GitHub Environment secrets
CLOUDFLARE_API_TOKEN=
VPS_SSH_KEY=
GHCR_READ_TOKEN=
SIGNIN_GITHUB_CLIENT_ID=
SIGNIN_GITHUB_CLIENT_SECRET=
SIGNIN_GITHUB_EXTENSION_REDIRECT_URL=
SIGNIN_GITHUB_EXTENSION_FIREFOX_REDIRECT_URL=
ADMIN_SPA_URL=https://gitiempo-admin.gitiempo.com

# VPS prerequisite for private API images:
# Docker on the VPS must already be logged into ghcr.io with read access to
# ghcr.io/<owner>/<repo>/api, unless the API package is public.
